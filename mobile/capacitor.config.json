{
  "appId": "com.waveavi.dboarddesigner",
  "appName": "DBoard Designer",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "always",
    "scheme": "DBoard Designer",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#F5F7F9",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DEFAULT",
      "overlaysWebView": false
    },
    "SystemBars": {
      "insetsHandling": "native"
    }
  },
  "backgroundColor": "#F5F7F9"
}
