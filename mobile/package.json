{
  "name": "dboard-designer-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Android and iPhone apps for DBoard Designer (Capacitor wrapper around ../public)",
  "scripts": {
    "prepare-www": "node prepare-www.mjs",
    "sync": "node prepare-www.mjs && npx cap sync",
    "assets": "npx capacitor-assets generate --android --ios --iconBackgroundColor '#0B6B8E' --iconBackgroundColorDark '#0B6B8E' --splashBackgroundColor '#F5F7F9' --splashBackgroundColorDark '#15202A'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
