{
  // Cloudflare Worker that serves DBoard Designer and its small admin API.
  "name": "d-board-designer",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Public settings (safe in source control). Replace with your own project values, or set them in the dashboard.
  "observability": { "logs": { "enabled": true, "invocation_logs": true, "persist": true } },
  "vars": {
    "SUPABASE_URL": "https://lnplifeexjwbjpsbexew.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxucGxpZmVleGp3Ympwc2JleGV3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIwMjcyODMsImV4cCI6MjEwNzYwMzI4M30.oZxY2i6PDZofm0SB9s70NfXgIU1jICFlFru_beDVtLI",
    "REQUIRE_LOGIN": "true"
  }
  // Secret (never put in this file). Set with:  npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
}
